# Brevo (formerly Sendinblue) API Integration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=kdfacilitiesmanagementservices@gmail.com
BREVO_SENDER_NAME="KD Facilities Management Services"
BREVO_NOTIFICATION_EMAIL=kdfacilitiesmanagementservices@gmail.com

# Direct Gmail SMTP (Recommended for @gmail.com to guarantee 100% instant inbox delivery)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Site URL
NEXT_PUBLIC_SITE_URL=https://www.kdfmservices.com

# Optional Resend Fallback
RESEND_API_KEY=

# Supabase Cloud Database (PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
